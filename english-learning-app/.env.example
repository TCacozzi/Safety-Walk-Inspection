# Copy this file to .env and fill in your real API key.
# Never commit the real .env file.

# Your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Port the backend listens on (Render sets this automatically in production)
PORT=3001

# Your Resend API key (resend.com), for sending account emails.
# Without it, the app still works but no emails are sent.
RESEND_API_KEY=re_...

# Sender shown on emails. Without a verified domain on Resend, you must
# keep the resend.dev address below.
EMAIL_FROM=Manda Bem! <onboarding@resend.dev>

# Supabase project (supabase.com), for shared cloud storage of users,
# subjects and progress. Without these, the app still runs but every
# browser/device sees its own separate (empty) data.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
