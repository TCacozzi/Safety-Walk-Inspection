# Copy this file to .env and fill in your real API key.
# Never commit the real .env file.

# Your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Port the backend listens on (Render sets this automatically in production)
PORT=3001

# A Gmail account used to send account emails (cadastro, aprovação,
# redefinição de senha) via SMTP. Without these, the app still works but no
# emails are sent. GMAIL_APP_PASSWORD is a 16-character "App Password"
# generated at myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled on that Google account) - not the account's normal
# login password.
GMAIL_USER=mandabem67@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Sender shown on emails. Defaults to "Manda Bem! <GMAIL_USER>" if unset.
EMAIL_FROM=Manda Bem! <mandabem67@gmail.com>

# Supabase project (supabase.com), for shared cloud storage of users,
# subjects and progress. Without these, the app still runs but every
# browser/device sees its own separate (empty) data.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Public URL of the deployed frontend (Vercel), used to build the link sent
# in "forgot password" emails. Locally the default below already works.
FRONTEND_URL=http://localhost:5173
