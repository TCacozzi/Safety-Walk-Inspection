# Copy this file to .env and set it to your backend's URL.
# Locally the default (http://localhost:3001) already works without this file.
# In production (Vercel), set VITE_API_URL as an Environment Variable
# pointing to your deployed backend (e.g. https://manda-bem-api.onrender.com).

VITE_API_URL=http://localhost:3001
